# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# Yerel değerler için: npm run db:status  (API URL ve "Publishable" anahtar)
#
# YALNIZCA publishable anahtar (sb_publishable_…) buraya yazılır.
# EXPO_PUBLIC_ ile başlayan her değer derlenen uygulamanın içine açık metin olarak girer.
# Secret anahtar (sb_secret_…) ve veritabanı şifresi ASLA buraya yazılmaz.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
